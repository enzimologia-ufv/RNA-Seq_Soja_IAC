# ==============================
# PASSO 1 - PACOTES
# ==============================

library(DESeq2)
library(ggplot2)
library(pheatmap)
library(RColorBrewer)
library(apeglm)   # shrink logFC (melhor interpretação)

# ==============================
# PASSO 2 - IMPORTAÇÃO
# ==============================

counts <- read.table("counts.txt", 
                     header = TRUE, 
                     row.names = 1, 
                     comment.char = "")

# remover colunas extras do featureCounts
counts <- counts[,6:ncol(counts)]

# limpar nomes das colunas (opcional)
colnames(counts) <- gsub(".bam", "", colnames(counts))

# ==============================
# PASSO 3 - METADATA
# ==============================

sample_info <- data.frame(
  row.names = colnames(counts),
  condition = c("controle","controle","tratamento","tratamento")
)

sample_info$condition <- factor(sample_info$condition)

# ==============================
# PASSO 4 - DDS
# ==============================

dds <- DESeqDataSetFromMatrix(
  countData = counts,
  colData = sample_info,
  design = ~ condition
)

# ==============================
# PASSO 5 - FILTRO
# ==============================

keep <- rowSums(counts(dds)) >= 20
dds <- dds[keep, ]

# ==============================
# PASSO 6 - DESEQ
# ==============================

dds <- DESeq(dds)

# ==============================
# PASSO 7 - RESULTADOS
# ==============================

res <- results(dds, contrast = c("condition", "tratamento", "controle"))

# ordenar por p-ajustado
res <- res[order(res$padj), ]

# ==============================
# PASSO 8 - SHRINK
# ==============================

resLFC <- lfcShrink(dds,
                    coef="condition_tratamento_vs_controle",
                    type="apeglm")

# ==============================
# PASSO 9 - NORMALIZAÇÃO
# ==============================

vsd <- vst(dds, blind = FALSE)


