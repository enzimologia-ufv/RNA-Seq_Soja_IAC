# ==============================
# PASSO 1 - PACOTES
# ==============================

library(DESeq2)
library(ggplot2)
library(pheatmap)
library(RColorBrewer)
library(apeglm)   # shrink logFC (melhor interpretação)

# ==============================
# PASSO 2 - IMPORTAÇÃO
# ==============================

counts <- read.table("counts.txt",
                     header=TRUE,
                     row.names=1,
                     comment.char="")

counts <- counts[,6:ncol(counts)]

# limpar nomes
colnames(counts) <- gsub(".bam", "", colnames(counts))

# ==============================
# PASSO 3 - METADATA
# ==============================

sample_names <- colnames(counts)

genotype <- gsub("-[0-9]+", "", sample_names)

sample_info <- data.frame(
  row.names = sample_names,
  genotype = factor(genotype)
)

sample_info

# ==============================
# PASSO 4 - DDS
# ==============================

dds <- DESeqDataSetFromMatrix(
  countData = counts,
  colData = sample_info,
  design = ~ genotype
)

# ==============================
# PASSO 5 - FILTRO
# ==============================

keep <- rowSums(counts(dds)) >= 20
dds <- dds[keep, ]

# ==============================
# PASSO 6 - DESEQ
# ==============================

dds <- DESeq(dds)

resultsNames(dds)

# ==============================
# PASSO 7 - RESULTADOS
# ==============================

genotypes <- levels(sample_info$genotype)

comparisons <- combn(genotypes, 2, simplify = FALSE)

results_list <- list()

for (comp in comparisons) {
  
  g1 <- comp[1]
  g2 <- comp[2]
  
  cat("Comparando:", g1, "vs", g2, "\n")
  
  res <- results(dds, contrast = c("genotype", g1, g2))
  
  # shrink logFC
  coef_name <- paste0("genotype_", g1, "_vs_", g2)
  
  resLFC <- lfcShrink(dds,
                      contrast = c("genotype", g1, g2),
                      type = "apeglm")
  
  resLFC <- resLFC[order(resLFC$padj), ]
  
  results_list[[paste(g1, "vs", g2, sep = "_")]] <- resLFC
  
  write.csv(as.data.frame(resLFC),
            paste0("DE_", g1, "_vs_", g2, ".csv"))
}

# ==============================
# PASSO 9 - NORMALIZAÇÃO
# ==============================

vsd <- vst(dds, blind = FALSE)


